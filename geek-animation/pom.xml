<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>leetcode</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>geek-animation</artifactId>
    <packaging>jar</packaging>
    <name>geek-animation</name>
    <description>Algorithm Animation Module</description>

    <dependencies>
        <!-- 依赖geek-common模块 -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>geek-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        
        <!-- 依赖geek-easy模块获取算法实现 -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>geek-easy</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        
        <!-- 依赖geek-normal模块获取算法实现 -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>geek-normal</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        
        <!-- 依赖geek-hard模块获取算法实现 -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>geek-hard</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Swing UI -->
        <dependency>
            <groupId>org.swinglabs</groupId>
            <artifactId>swingx</artifactId>
            <version>1.6.1</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.animation.launcher.AlgorithmTreeLauncher</mainClass>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.animation.launcher.AlgorithmTreeLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>